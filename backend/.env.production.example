# ==============================================================================
# SourceFlow Backend Production Environment Template
# NEVER COMMIT REAL PRODUCTION SECRETS TO GIT
# ==============================================================================

# Server Network Configuration
NODE_ENV=production
PORT=5000

# Allowed Frontend Origins (Comma-separated for multiple domains/subdomains)
FRONTEND_URL=https://app.sourceflow.io
ALLOWED_ORIGINS=https://app.sourceflow.io,https://sourceflow.vercel.app

# Real Backend Mode (MUST BE false IN PRODUCTION)
DEMO_MODE=false

# Supabase Production Project (Server-Side Private Credentials)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...<your-production-anon-key>
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...<your-production-service-role-key>

# External AI & OCR Providers
OPENAI_API_KEY=sk-proj-...<your-production-openai-api-key>
OCR_API_KEY=helloworld...<your-production-ocr-space-api-key>

# Machine Translation Provider (LibreTranslate)
LIBRETRANSLATE_URL=https://translate.yourdomain.com
LIBRETRANSLATE_API_KEY=<your-libretranslate-api-key-if-required>
TRANSLATION_TIMEOUT_MS=15000
MAX_TRANSLATION_CHARS=50000

# Indian Government Open Data & Institutional APIs (HTTPS only)
DATA_GOV_IN_API_KEY=<your-data-gov-in-api-key>
DATA_GOV_IN_BASE_URL=https://api.data.gov.in
API_SETU_CLIENT_ID=<your-api-setu-client-id>
API_SETU_API_KEY=<your-api-setu-api-key>
API_SETU_BASE_URL=https://apisetu.gov.in
GOV_CACHE_TTL_MS=600000

# Logging and Diagnostics
LOG_LEVEL=info
