# ==============================================================================
# SourceFlow Backend — Environment Variables Template
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env — it is gitignored.
# NEVER put private secrets in VITE_* variables.
# ==============================================================================

# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Primary allowed frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# Additional comma-separated origins (production: set to Vercel domain)
ALLOWED_ORIGINS=

# Set DEMO_MODE=true only for offline development without real Supabase
DEMO_MODE=false

# ─── Supabase (Server-Side ONLY — NEVER expose to frontend) ───
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sourceflow-files

# ─── File Storage ─────────────────────────────────────────
MAX_FILE_SIZE_MB=25

# ─── OpenAI (Server-Side ONLY) ────────────────────────────
# Optional — backend starts and works without this key.
# AI endpoints return 503 when key is absent/has no credits.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=60000

# ─── OCR (Server-Side ONLY) ───────────────────────────────
# Register at https://ocr.space/ocrapi
OCR_API_KEY=
OCR_TIMEOUT_MS=30000

# ─── Translation / LibreTranslate (Server-Side ONLY) ──────
# Self-host: https://github.com/LibreTranslate/LibreTranslate
# Note: SourceFlow backend uses port 5000; default LibreTranslate is 5001
LIBRETRANSLATE_URL=http://localhost:5001
LIBRETRANSLATE_API_KEY=
TRANSLATION_TIMEOUT_MS=30000
TRANSLATION_MAX_CHARS=20000

# ─── Government APIs (Server-Side ONLY) ───────────────────
# data.gov.in — Register at https://data.gov.in/help/how-use-apis
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_BASE_URL=https://api.data.gov.in

# API Setu — Requires institutional onboarding at https://apisetu.gov.in
API_SETU_CLIENT_ID=
API_SETU_API_KEY=
API_SETU_BASE_URL=https://apisetu.gov.in

# Government dataset cache TTL (milliseconds — default 10 minutes)
GOV_CACHE_TTL_MS=600000
