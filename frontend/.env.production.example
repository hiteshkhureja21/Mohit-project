# ==============================================================================
# SourceFlow Frontend Production Environment Template (Vercel)
# Only publishable, client-safe variables are defined here
# NEVER PUT SERVICE ROLE KEYS OR PRIVATE API KEYS IN THIS FILE
# ==============================================================================

# Production Express Backend URL (HTTPS)
VITE_API_URL=https://api.sourceflow.io

# Supabase Production Project (Public Client Safe Keys)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...<your-production-anon-key>

# Production Mode Flag (MUST BE false IN PRODUCTION)
VITE_DEMO_MODE=false
