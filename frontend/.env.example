# ==========================================
# SourceFlow Frontend Environment (Vite)
# ==========================================

# API Endpoint for Express backend
VITE_API_URL=http://localhost:5000

# Supabase Auth Configuration (Publishable Client ONLY)
# NEVER put SUPABASE_SERVICE_ROLE_KEY or private secrets in this file.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Production defaults to false (Real Backend Mode)
# Set to true only for local UI demo development with mock data
VITE_DEMO_MODE=false
