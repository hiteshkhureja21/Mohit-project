# ==========================================
# SourceFlow Environment Configuration
# ==========================================

# ------------------------------------------
# Frontend Variables (Client-side / Vite)
# ------------------------------------------
# Points to the Node.js + Express backend API
VITE_API_URL=http://localhost:5000
VITE_DEMO_MODE=false

# ------------------------------------------
# Backend Variables (Server-side / Node.js)
# ------------------------------------------
PORT=5000
FRONTEND_URL=http://localhost:5173
DEMO_MODE=false

# Supabase Configuration (Backend ONLY - Keep secure)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-public-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-private-key

# External AI & OCR Services (Backend ONLY - Never expose to frontend)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_MS=60000
# OCR_API_KEY=...
# OCR_TIMEOUT_MS=30000

